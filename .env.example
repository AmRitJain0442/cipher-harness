HARNESS_MODEL=cyberstrike
HARNESS_MODEL_BASE=http://127.0.0.1:8082/v1
HARNESS_UPSTREAM_BASE=http://127.0.0.1:8080/v1
HARNESS_API_KEY_FILE=/path/to/private/model-key
HARNESS_OWNER_KEY_FILE=/path/to/private/owner-key
HARNESS_PENTAGI_PASSWORD_FILE=/path/to/private/pentagi-password
HARNESS_SECURITY_DIR=/path/to/framework-installations
HARNESS_PENTAGI_BASE=https://127.0.0.1:8443/api/v1
HARNESS_TEMPEST_BASE=http://127.0.0.1:3333
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8092
# Optional container-facing gateway bind (leave empty for localhost only).
HARNESS_GATEWAY_DOCKER_HOST=
# Optional Gemini command correction for actual runtime agents (Vertex AI).
HARNESS_GEMINI_PROJECT=
HARNESS_GEMINI_LOCATION=global
HARNESS_GEMINI_MODEL=gemini-3.1-pro-preview
HARNESS_GEMINI_CREDENTIALS_FILE=/path/to/private/service-account.json
